{
  "name": "courselens",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first course study assistant using LangGraph",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "agent-smoke": "node --import tsx scripts/langgraph-study.ts",
    "agent-memory-smoke": "node --import tsx scripts/langgraph-study.ts --fixture --scenario memory",
    "agent-research-smoke": "node --import tsx scripts/langgraph-study.ts --fixture --scenario research",
    "agent-tools-smoke": "node --import tsx scripts/langgraph-study.ts --fixture --scenario tools",
    "check": "pnpm run typecheck",
    "lightrag": "tsx scripts/lightrag.ts",
    "normalize": "tsx scripts/normalize.ts",
    "scan": "tsx scripts/scan-resources.ts --config config/sources.local.json --output data/runtime/resources.json",
    "smoke:lightrag": "tsx scripts/smoke-lightrag.ts",
    "smoke:memory": "tsx scripts/memory-smoke.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "agent:graph": "node --import tsx scripts/langgraph-study.ts",
    "checkpoint:init": "node --import tsx scripts/init-checkpoints.ts",
    "start": "node --import tsx scripts/courselens-server.ts",
    "eval:study": "node --import tsx scripts/evaluate-courselens.ts",
    "test:harness": "node --import tsx --test tests/study-routing.test.ts tests/study-web.test.ts tests/lightrag-knowledge-service.test.ts tests/memory-intelligence.test.ts tests/hybrid-knowledge.test.ts"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "devDependencies": {
    "@langchain/core": "1.4.0",
    "@types/node": "^22.20.0",
    "@types/pg": "^8.23.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@monash-study/knowledge-service": "workspace:*",
    "@monash-study/langgraph-runtime": "workspace:*",
    "@monash-study/memory-service": "workspace:*",
    "@monash-study/shared-types": "workspace:*",
    "@monash-study/study-application": "workspace:*",
    "@monash-study/study-controller": "workspace:*",
    "@monash-study/study-core": "workspace:*",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "4.4.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "tsx": "^4.22.4"
  },
  "packageManager": "pnpm@12.5.1"
}
